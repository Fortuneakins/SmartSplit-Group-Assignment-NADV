# Copy this file to .env and adjust if needed. All services read from this file.

# --- Database ---
DATABASE_URL=postgresql://smartsplit:smartsplit@localhost:5432/smartsplit

# --- Auth ---
JWT_SECRET=change-this-super-secret-key-before-any-real-deployment
JWT_EXPIRES_IN=2h

# --- Service ports (all run on localhost during dev) ---
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
EXPENSE_SERVICE_PORT=3002
SETTLEMENT_SERVICE_PORT=3003

# --- Service URLs (how the gateway/settlement-service reach each other) ---
USER_SERVICE_URL=http://localhost:3001
EXPENSE_SERVICE_URL=http://localhost:3002
SETTLEMENT_SERVICE_URL=http://localhost:3003

# --- Gateway rate limiting (requests per IP per minute) ---
# Kept low by default for production-realistic behaviour; raised for scripts/perf-test.js.
RATE_LIMIT_MAX=1000

SERVICE_TIMEOUT_MS=5000
SERVICE_RETRIES=2
